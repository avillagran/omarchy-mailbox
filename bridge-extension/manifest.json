{
  "manifest_version": 3,
  "name": "Gmailbox Local Bridge",
  "version": "0.3.2",
  "description": "Shares Gmail previews and optional local plain-text conversation cache with Omarchy Gmailbox. No passwords, cookies or OAuth tokens leave this computer.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://mail.google.com/*"],
  "content_scripts": [{
    "matches": ["https://mail.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Gmailbox Local Bridge"}
}

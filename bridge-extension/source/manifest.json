{
  "manifest_version": 3,
  "name": "Mailbox Local Bridge",
  "version": "0.0.7",
  "description": "Shares Gmail background feed checks, Gmail and HEY previews, and optional local plain-text conversation cache with Omarchy Mailbox. No passwords, cookies or OAuth tokens leave this computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://mail.google.com/*", "https://app.hey.com/*"],
  "content_scripts": [{
    "matches": ["https://mail.google.com/*", "https://app.hey.com/*"],
    "js": ["hey-provider.js", "content.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mailbox Local Bridge", "default_icon": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png"
  }}
}

{
  "manifest_version": 3,
  "name": "Mailbox Local Bridge",
  "version": "0.0.2",
  "description": "Shares Gmail and HEY previews plus optional local plain-text conversation cache with Omarchy Mailbox. No passwords, cookies or OAuth tokens leave this computer.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://mail.google.com/*", "https://app.hey.com/*"],
  "content_scripts": [{
    "matches": ["https://mail.google.com/*", "https://app.hey.com/*"],
    "js": ["hey-provider.js", "content.js"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mailbox Local Bridge"}
}
